#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)"
CLI="$SCRIPT_DIR/mcp-server/setup-cli.js"
if [ ! -f "$CLI" ]; then
  echo "Error: TypeScript setup bundle not found at $CLI" >&2
  echo "Build it with: cd mcp-server && npm run rebuild" >&2
  exit 1
fi

exec node "$CLI" "$@"
