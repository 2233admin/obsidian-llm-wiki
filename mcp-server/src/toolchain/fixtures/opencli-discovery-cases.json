      "exitCode": 0,
      "stdout": "{\"version\":\"1.8.6\",\"name\":\"opencli\"}\n"
    },
    "expected": {
      "ok": true,
      "partial": false,
      "timedOut": false,
      "observedVersion": "1.8.6",
      "capabilities": ["version.structured"],
      "missingCapabilities": [],
      "boundary": "capture-provider"
    }
  },
