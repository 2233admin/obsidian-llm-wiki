  {
    "name": "secret-and-endpoint-redaction",
    "observation": {
      "surface": "doctor",
      "command": [
        "opencli",
        "--api-key",
        "flag-secret",
        "doctor",
        "--format",
        "json",
        "https://user:pass@private.example.test/v1?api_key=query-secret"
      ],
      "exitCode": 0,
      "stdout": "{\"healthy\":true,\"note\":\"provider reflected sk-outputsecret99 and https://user:pass@private.example.test\",\"authorization\":\"bearer sk-abcdefghi\"}\n"
    },
    "expected": {
      "ok": true,
      "partial": false,
      "timedOut": false,
      "capabilities": ["doctor"],
      "forbidden": [
        "flag-secret",
        "user:pass",
        "query-secret",
        "sk-outputsecret99",
        "sk-abcdefghi"
      ]
    }
  },
