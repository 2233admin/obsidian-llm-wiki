{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.llmwiki.org/agent-wiki/v1/maintenance-queue-entry.schema.json",
  "type": "object",
  "required": ["schemaVersion", "entryId", "sourceIds", "topicKeys", "dirtyReasons", "earliestRunAt", "freshnessDeadline", "attempts", "state", "receiptIds"],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "entryId": { "$ref": "common.schema.json#/$defs/identifier" },
    "sourceIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/identifier" } },
    "topicKeys": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/identifier" } },
    "dirtyReasons": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/identifier" } },
    "earliestRunAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "freshnessDeadline": { "$ref": "common.schema.json#/$defs/timestamp" },
    "attempts": { "type": "integer", "minimum": 0 },
    "state": { "enum": ["pending", "leased", "retry", "quarantined", "completed"] },
    "receiptIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/identifier" } },
    "lease": {
      "type": "object",
      "required": ["owner", "acquiredAt", "expiresAt"],
      "properties": {
        "owner": { "$ref": "common.schema.json#/$defs/identifier" },
        "acquiredAt": { "$ref": "common.schema.json#/$defs/timestamp" },
        "expiresAt": { "$ref": "common.schema.json#/$defs/timestamp" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
